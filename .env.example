# Settings for docker compose (this file sits next to docker-compose.yml).
#   cp .env.example .env    — then fill in real values. Full guide: DEPLOY.md
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# development | production  (production refuses to start with unsafe values below)
ENVIRONMENT=development
# Your domain, used by Caddy for the HTTPS certificate (production overlay)
DOMAIN=master-ryadom.kg
# Public address of the site — links in SMS/Telegram messages
SITE_URL=http://localhost:8080

JWT_SECRET=change-me-in-production
# Allowed web origins, comma-separated, e.g. https://master-ryadom.kg
CORS_ORIGINS=*
POSTGRES_PASSWORD=master_ryadom

# SMS: console = codes only in the server log (development). Real gateway — see backend/app/sms.py
SMS_PROVIDER=console

# Telegram bot for master notifications (create with @BotFather). Empty = Telegram option hidden.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Paid plan for masters (off until launch). When true: 30-day trial, then monthly payment.
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_TRIAL_DAYS=30
# Price for 1 month, сом (3/6/12 months get 10/15/25% off — PLANS in app/subscriptions.py)
SUBSCRIPTION_PRICE=500
# manual = admin confirms payments in the admin panel; real acquirers are added in app/payments.py
PAYMENT_PROVIDER=manual

# Email for master notifications: console = log only. smtp = real sending (Gmail/Yandex/Mail.ru app password, or any SMTP)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (587) | ssl (465)
SMTP_SECURITY=starttls
