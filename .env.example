# Used by docker-compose for variable substitution. Copy to .env (same directory
# as docker-compose.yml) and fill in real values before deploying:
#   cp .env.example .env

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Comma-separated list of allowed web origins in production, e.g. https://master-ryadom.kg
CORS_ORIGINS=*

# Postgres password (also update DATABASE_URL below to match if you change it)
POSTGRES_PASSWORD=master_ryadom
