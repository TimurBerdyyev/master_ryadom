# Used by docker-compose for variable substitution. Copy to .env (same directory
# as docker-compose.yml) and fill in real values before deploying:
#   cp .env.example .env

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# Comma-separated list of allowed web origins in production, e.g. https://master-ryadom.kg
CORS_ORIGINS=*

# Postgres password (also update DATABASE_URL below to match if you change it)
POSTGRES_PASSWORD=master_ryadom

# Paid plan for masters (off until launch). When true: 30-day trial, then monthly payment.
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_TRIAL_DAYS=30
# Price for 1 month, сом (3/6/12 months get 10/15/25% off — PLANS in app/subscriptions.py)
SUBSCRIPTION_PRICE=500
# manual = admin confirms payments in the admin panel; real acquirers are added in app/payments.py
PAYMENT_PROVIDER=manual
