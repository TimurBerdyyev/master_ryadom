DATABASE_URL=postgresql://master_ryadom:master_ryadom@db:5432/master_ryadom
REDIS_URL=redis://redis:6379/0
# Generate a real secret before deploying, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# Comma-separated list of allowed origins in production, e.g. https://master-ryadom.kg
CORS_ORIGINS=*
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Paid plan for masters (off until launch). When true: 30-day trial, then monthly payment.
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_TRIAL_DAYS=30
# Price for 1 month, сом (3/6/12 months get 10/15/25% off — PLANS in app/subscriptions.py)
SUBSCRIPTION_PRICE=500
# manual = admin confirms payments in the admin panel; real acquirers are added in app/payments.py
PAYMENT_PROVIDER=manual

# SMS (codes, opt-in notifications): console = log only, for development. See app/sms.py
SMS_PROVIDER=console
# Telegram bot for master notifications. Local testing: python -m app.telegram_poll
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SITE_URL=http://localhost:8080
